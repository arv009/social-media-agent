# Copy this file to .env (local) or paste the same keys into Streamlit Cloud > App settings > Secrets
# (as KEY = "value"). Never commit .env.

# --- App ---
# The app's URL, used as the sign-in redirect URL for every Connect button.
# Leave empty to auto-detect. Examples: http://localhost:8501  or  https://your-app.streamlit.app
APP_URL=
# Strongly recommended on Streamlit Cloud: anyone with the link could otherwise post and spend API credits.
APP_PASSWORD=

# --- AI agent (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default), claude-sonnet-5-5 or claude-opus-5-5
CLAUDE_MODEL=claude-haiku-5-5

# --- Publishing, scheduling & analytics (recommended) ---
# Buffer: publish.buffer.com > Settings > API > create key. Connect your accounts inside Buffer first.
BUFFER_API_KEY=
# Your timezone, so suggested post times are right (Streamlit Cloud runs on UTC)
APP_TIMEZONE=Asia/Manila
# Cloudinary (free): the "API environment variable" from the dashboard. Hosts approved images for Buffer.
CLOUDINARY_URL=

# --- Optional direct connections: app credentials for each service (redirect URL = APP_URL) ---
# Facebook & Instagram: developers.facebook.com > Create app (Business) > Facebook Login for Business
META_APP_ID=
META_APP_SECRET=
# Meta retires Graph API versions about 2 years after release. Use a current one.
META_GRAPH_VERSION=v23.0
# LinkedIn: linkedin.com/developers > Products: Sign In with LinkedIn (OpenID) + Share on LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Canva: canva.com/developers > Create integration
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Google Drive: console.cloud.google.com > Drive API > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: use a Page token directly instead of the Connect button ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
