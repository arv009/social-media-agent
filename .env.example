# Copy this file to .env and fill in your own values. Never commit .env.

# --- Meta (Facebook Page + Instagram Business) ---
# Create an app at https://developers.facebook.com, then get a Page access token
# with pages_read_engagement, read_insights, instagram_basic, instagram_manage_insights.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Meta retires Graph API versions about 2 years after release. Use a current one.
META_GRAPH_VERSION=v23.0

# --- Canva (https://www.canva.com/developers/integrations) ---
# Redirect URL to register: http://127.0.0.1:3001/oauth/redirect, then run scripts/canva_login.py
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# --- Other ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default), claude-sonnet-5-5 or claude-opus-5-5
CLAUDE_MODEL=claude-haiku-5-5
BUFFER_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
